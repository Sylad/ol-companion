{
  "name": "ol-companion-frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/plan-data.mjs --leaks dist",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:navigateur": "vitest run -c vitest.navigateur.config.ts",
    "plan": "node scripts/plan-data.mjs",
    "news": "rm -rf public/nouveautes-data && cadence news build -o public/nouveautes-data && rm -f public/nouveautes-data/index.html && node scripts/nouveautes-tailles.mjs"
  },
